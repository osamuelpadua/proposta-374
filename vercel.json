{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "https://www.samuelpadua.com.br", "permanent": false }
  ],
  "rewrites": [
    { "source": "/drgabrielgoncalves/", "destination": "/378/index.html" },
    { "source": "/drgabrielgoncalves/:path+", "destination": "/378/:path+" },
    { "source": "/drrodrigoedragabi/", "destination": "/379/index.html" },
    { "source": "/drrodrigoedragabi/:path+", "destination": "/379/:path+" },
    { "source": "/drrodrigoedragabi-funcionalidades/", "destination": "/380/index.html" },
    { "source": "/drrodrigoedragabi-funcionalidades/:path+", "destination": "/380/:path+" },
    { "source": "/reliquia-interiores/", "destination": "/381/index.html" },
    { "source": "/reliquia-interiores/:path+", "destination": "/381/:path+" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
